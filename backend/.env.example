# ---------- StudyHub Backend configuration ----------
# Copy this file to ".env" and adjust the values.

# Port the Express server listens on
PORT=5000

NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/studyhub
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/studyhub
MONGO_URI=mongodb://127.0.0.1:27017/studyhub

# Secret used to sign JSON Web Tokens - change this to a long random string
JWT_SECRET=studyhub_super_secret_change_me_in_production

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Client URL (used for CORS in production)
CLIENT_URL=http://localhost:5173
